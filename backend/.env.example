# ==============================================================================
# LÁ CHẮN NGƯỜI THÂN - BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# HƯỚNG DẪN: Sao chép file này thành .env và điền các giá trị thực tế của bạn.
# Tuyệt đối không commit file .env chứa thông tin bí mật lên Git!

# Cấu hình máy chủ
PROJECT_NAME="Lá Chắn Người Thân - Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Danh sách domain Frontend được phép truy cập (CORS)
# Ngăn chặn truy cập trái phép từ các trang web lạ
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Khóa bí mật máy chủ (Dùng để mã hóa JWT, sinh chuỗi ngẫu nhiên dài và bảo mật)
SECRET_KEY="replace_this_with_a_super_secret_key_in_production"

# Cấu hình Cơ sở dữ liệu (Dành cho Milestone 2 trở đi)
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/lachanguoithan"

# Khóa API OpenAI (Dành cho Milestone 3 - Động cơ AI)
# OPENAI_API_KEY="sk-proj-your-api-key-here"
